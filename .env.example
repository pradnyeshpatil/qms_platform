# Copy to .env (docker compose reads it automatically). Never commit .env.
POSTGRES_DB=qms
POSTGRES_USER=qms
POSTGRES_PASSWORD=qms
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Onboarding / email (Phase 1) ---------------------------------------------------------
# Dev default prints emails (invitations) to the backend console. Set SMTP values for real mail:
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com  EMAIL_PORT=587  EMAIL_USE_TLS=1
#   EMAIL_HOST_USER=...  EMAIL_HOST_PASSWORD=...  DEFAULT_FROM_EMAIL="QMS <no-reply@example.com>"
FRONTEND_URL=http://localhost:5173
INVITATION_TTL_DAYS=7
TRIAL_DAYS=14
